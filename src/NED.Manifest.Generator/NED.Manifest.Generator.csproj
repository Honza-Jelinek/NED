<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ned-manifest</AssemblyName>
    <RootNamespace>NED.Manifest.Generator</RootNamespace>
    <Description>Generates a NED node manifest from an annotated assembly.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NED.Abstractions\NED.Abstractions.csproj" />
  </ItemGroup>

</Project>
