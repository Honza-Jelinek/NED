@namespace NED.Core
@using NED.Abstractions.Manifest
@* Widget pro SubgraphNodeModel — reference na subgraf.
   Vizuálně totožný s DataNodeWidget: header + porty + inline fields.
   Porty pochází z rozhraní (SubgraphInterface), ne z reflexe. *@
@inject NedTheme Theme
@inject NedCatalog Catalog
@inject IStringLocalizer<Strings> Loc

@{
    IReadOnlyList<ValidationIssue> issues = Bridge?.IssuesFor(Node) ?? Array.Empty<ValidationIssue>();
    var hasError = issues.Any(i => i.Severity == IssueSeverity.Error);
    var hasWarn = issues.Any(i => i.Severity == IssueSeverity.Warning);
    var vCls = hasError ? " node-invalid" : hasWarn ? " node-warn" : "";
    var rootCls = $"data-node dn-cat-subgraph{(Node.Selected ? " node-selected" : "")}{vCls}";
}

<div class="@rootCls"
     @ondblclick:stopPropagation="true">

    @if (issues.Count > 0)
    {
        <NedTooltip Description="@IssueText(issues)" Placement="Placement.Right">
            <div class="dn-badge @(hasError ? "dn-badge-err" : "dn-badge-warn")">@issues.Count</div>
        </NedTooltip>
    }

    @* ── Header ── *@
    <div class="dn-header" style="@HeaderStyle">
        <span class="dn-icon">⧉</span>
        <span class="dn-title">@Node.SubgraphName</span>
    </div>

    @* ── Porty + output ── *@
    @if (Node.ExecInput is not null || Node.InputPorts.Count > 0 || Node.Outputs.Count > 0)
    {
        <div class="dn-ports" @onmousedown:stopPropagation>
            <div class="dn-inputs">
                @* Exec vstup nepatří do InputPorts (ty jsou klíčované jménem parametru,
                   a „In" je zrovna VÝCHOZÍ jméno parametru) — kreslí se zvlášť a první. *@
                @if (Node.ExecInput is { } execIn)
                {
                    var execCls = "dn-port-row dn-in-row dn-exec"
                        + (execIn.Links.Count > 0 ? " dn-conn" : "");
                    <NedTooltip TypeLine="@execIn.TypeLine" Placement="Placement.Left">
                        <div class="@execCls" style="--pc:@PortColorFor(execIn)">
                            <PortRenderer Port="execIn" />
                            <span class="dn-port-label">@execIn.Label</span>
                        </div>
                    </NedTooltip>
                }
                @foreach (var inp in Node.Interface.Inputs.Where(Node.IsPort)
                    .OrderByDescending(input => input.Type == TypeIds.Exec))
                {
                    if (!Node.InputPorts.TryGetValue(inp.Name, out var port)) continue;
                    var color = PortColorFor(port);
                    var rowCls = "dn-port-row dn-in-row"
                        + (port.DataType == TypeIds.Exec ? " dn-exec" : "")
                        + (port.Links.Count > 0 ? " dn-conn" : "");
                    <NedTooltip TypeLine="@port.TypeLine" Description="@port.Description" Placement="Placement.Left">
                        <div class="@rowCls" style="--pc:@color"
                             @oncontextmenu="e => OpenInputMenu(inp, e)"
                             @oncontextmenu:stopPropagation="true"
                             @oncontextmenu:preventDefault="true">
                            <PortRenderer Port="port" />
                            <span class="dn-port-label">@inp.Name</span>
                        </div>
                    </NedTooltip>
                }
            </div>
            <div class="dn-outputs">
                @foreach (var (name, output) in Node.Outputs
                    .OrderByDescending(item => item.Value.DataType == TypeIds.Exec))
                {
                    var outCls = "dn-port-row dn-out-row"
                        + (output.DataType == TypeIds.Exec ? " dn-exec" : "")
                        + (output.Links.Count > 0 ? " dn-conn" : "");
                    <NedTooltip TypeLine="@output.TypeLine" Description="@output.Description" Placement="Placement.Right">
                        <div class="@outCls" style="--pc:@PortColorFor(output)">
                            @if (Node.Outputs.Count > 1)
                            {
                                @* Jméno má smysl jen tam, kde je z čeho vybírat.
                                   U jediného výstupu je to text navíc na každém uzlu v grafu. *@
                                <span class="dn-port-label">@name</span>
                            }
                            <PortRenderer Port="output" />
                        </div>
                    </NedTooltip>
                }
            </div>
        </div>
    }

    @* ── Field-exposed vstupy (inline) ── *@
    @{ var fields = Node.Interface.Inputs.Where(i => !Node.IsPort(i)).ToList(); }
    @if (fields.Count > 0)
    {
        <div class="dn-body" @onmousedown:stopPropagation>
            @foreach (var inp in fields)
            {
                var isComplex = !TypeIds.IsScalar(inp.Type);
                <div class="dn-field @(inp.Type == TypeIds.Bool ? "dn-field-check" : "")"
                     @oncontextmenu="e => OpenInputMenu(inp, e)"
                     @oncontextmenu:stopPropagation="true"
                     @oncontextmenu:preventDefault="true">
                    <label class="dn-field-label">@inp.Name</label>
                    <NodeFieldInput TypeId="inp.Type" IsComplex="isComplex"
                                    ExcludeSubgraphId="Node.SubgraphId"
                                    Value="@GetFieldValue(inp.Name)"
                                    OnChange="v => SetFieldValue(inp.Name, v)" />
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public SubgraphNodeModel Node { get; set; } = null!;

    /// <summary>Můstek do NedCanvas (kontext menu vstupu). Cascaduje se shora.</summary>
    [CascadingParameter] public NodeEditorBridge? Bridge { get; set; }

    private const string SubgraphColor = "#3758CC";

    // Pravý klik na vstup → kontext menu pro přepnutí port↔pole (per-instance).
    private void OpenInputMenu(SubgraphInput inp, MouseEventArgs e)
    {
        if (Bridge is null) return;
        var isPort = Node.IsPort(inp);
        Bridge.OpenInputMenu(isPort, () => Node.SetExposure(inp.Name, !isPort), e.ClientX, e.ClientY);
    }

    private string HeaderStyle => $"background-color:{SubgraphColor};";

    private string PortColorFor(PortModel port)
    {
        var dt = (port as TypedPortModel)?.DataType;
        if (dt is null) return SubgraphColor;
        var c = Theme.PortColorFor(dt);
        if (c != Theme.AnyPortColor) return c;
        if (Catalog.Resolve(dt) is { } producer) return Theme.Resolve(producer).Color;
        return SubgraphColor;
    }

    private string GetFieldValue(string name) =>
        Node.FieldValues.TryGetValue(name, out var v) ? v : "";

    private void SetFieldValue(string name, object? raw)
    {
        Bridge?.RecordUndo();
        Node.FieldValues[name] = raw?.ToString() ?? "";
        Node.Refresh();
        Bridge?.Revalidate();
    }

    private string IssueText(IReadOnlyList<ValidationIssue> issues) =>
        string.Join("\n", issues.Select(i => i.Args is { Length: > 0 }
            ? string.Format(Loc[i.MessageKey], i.Args)
            : Loc[i.MessageKey].Value));
}
