{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ned.dev/schema/ned-export-v1.schema.json",
  "title": "NED export version 1",
  "type": "object",
  "required": ["exportVersion", "packs", "settings"],
  "properties": {
    "exportVersion": { "const": 1 },
    "packs": { "type": "array", "items": { "$ref": "#/$defs/pack" } },
    "settings": { "$ref": "#/$defs/settings" },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "outputs": { "type": "array" },
    "entry": { "type": ["string", "null"] },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/execNode" } },
    "exec": { "type": "array", "items": { "$ref": "#/$defs/execEdge" } },
    "functions": { "type": "array", "items": { "$ref": "#/$defs/function" } }
  },
  "oneOf": [
    {
      "required": ["outputs"],
      "properties": {
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/dataOutput" } }
      },
      "not": {
        "anyOf": [
          { "required": ["entry"] },
          { "required": ["nodes"] },
          { "required": ["exec"] },
          { "required": ["functions"] }
        ]
      }
    },
    {
      "required": ["entry", "nodes", "exec"],
      "properties": {
        "settings": {
          "type": "object",
          "required": ["graphKind"],
          "properties": { "graphKind": { "const": "exec" } },
          "additionalProperties": true
        },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/outputDeclaration" } }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "pack": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "graphKind": { "const": "exec" }
      },
      "additionalProperties": true
    },
    "input": {
      "type": "object",
      "required": ["name", "type", "default", "description"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "minLength": 1 },
        "default": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "outputDeclaration": {
      "type": "object",
      "required": ["name", "type", "multiple"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "multiple": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "dataOutput": {
      "type": "object",
      "required": ["name", "type", "multiple", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "multiple": { "type": "boolean" },
        "value": { "$ref": "#/$defs/value" }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["$id", "$type"],
      "properties": {
        "$id": { "type": "string", "minLength": 1 },
        "$type": { "type": "string", "minLength": 1 },
        "$output": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "call": {
      "type": "object",
      "required": ["$id", "$call"],
      "properties": {
        "$id": { "type": "string", "minLength": 1 },
        "$call": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "execNode": {
      "anyOf": [
        { "$ref": "#/$defs/node" },
        { "$ref": "#/$defs/call" },
        {
          "type": "object",
          "required": ["$id", "$error"],
          "properties": {
            "$id": { "type": "string", "minLength": 1 },
            "$error": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    },
    "ref": {
      "type": "object",
      "required": ["$ref"],
      "properties": {
        "$ref": { "type": "string", "minLength": 1 },
        "$output": { "type": "string", "minLength": 1 },
        "$cycle": { "const": true }
      },
      "additionalProperties": false
    },
    "param": {
      "type": "object",
      "required": ["$param"],
      "properties": { "$param": { "type": "string" } },
      "additionalProperties": false
    },
    "literal": {
      "type": "object",
      "required": ["$type", "value"],
      "properties": {
        "$type": { "const": "$literal" },
        "value": {}
      },
      "additionalProperties": false
    },
    "spread": {
      "type": "object",
      "required": ["$spread"],
      "properties": { "$spread": { "$ref": "#/$defs/value" } },
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "required": ["$list"],
      "properties": {
        "$list": { "type": "array", "items": { "$ref": "#/$defs/value" } }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["$error"],
      "properties": { "$error": { "type": "string" } },
      "additionalProperties": true
    },
    "execEdge": {
      "type": "object",
      "required": ["from", "pin", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "pin": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "function": {
      "type": "object",
      "required": ["id", "name", "entry", "nodes", "exec"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/outputDeclaration" } },
        "entry": { "type": ["string", "null"] },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/execNode" } },
        "exec": { "type": "array", "items": { "$ref": "#/$defs/execEdge" } }
      },
      "additionalProperties": false
    },
    "value": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        { "$ref": "#/$defs/node" },
        { "$ref": "#/$defs/ref" },
        { "$ref": "#/$defs/param" },
        { "$ref": "#/$defs/literal" },
        { "$ref": "#/$defs/spread" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/error" }
      ]
    }
  }
}
